#lang racket

;;===== Symbolic Image Reconstruction =====


(require racket/draw)
(provide red green blue render)

(define-syntax-rule (define-channel (name X) expr ...)
  (define (name X)
    (let ([values (list expr ...)])
      (/ (apply + values) (length values)))))

